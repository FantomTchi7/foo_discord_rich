IDD_PREFS_PROVIDERS_TAB DIALOGEX 0, 0, 327, 284
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "Tahoma", 400, 0, 0x0
BEGIN
    GROUPBOX        "MusicBrainz / Cover Art Archive",IDC_STATIC,6,6,314,46
    CONTROL         "Use this provider (no account or API key required)",IDC_CHECK_FETCH_ALBUM_ART,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,19,202,10
    LTEXT           "Uses a release MBID; otherwise requires artist + album.",IDC_STATIC,15,34,237,9
    PUSHBUTTON      "Details...",IDC_BUTTON_MUSICBRAINZ_HELP,258,18,54,14
    GROUPBOX        "TheAudioDB fallback",IDC_STATIC,6,55,314,68
    CONTROL         "Use TheAudioDB when earlier providers find no match",IDC_CHECK_FETCH_THEAUDIODB,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,68,205,10
    LTEXT           "Supporter API key (required):",IDC_STATIC,15,84,124,9
    EDITTEXT        IDC_EDIT_THEAUDIODB_API_KEY,15,96,112,14,ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL         "Show",IDC_CHECK_SHOW_THEAUDIODB_KEY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,132,98,30,10
    PUSHBUTTON      "Test",IDC_BUTTON_TEST_THEAUDIODB,166,96,30,14
    PUSHBUTTON      "Clear",IDC_BUTTON_CLEAR_THEAUDIODB_KEY,200,96,34,14
    PUSHBUTTON      "Get key...",IDC_BUTTON_THEAUDIODB_HELP,239,96,47,14
    GROUPBOX        "Local and embedded artwork",IDC_STATIC,6,126,314,117
    CONTROL         "Upload to Catbox (anonymous)",IDC_CHECK_UPLOAD_CATBOX,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,139,143,10
    PUSHBUTTON      "Test",IDC_BUTTON_TEST_CATBOX,265,136,47,14
    CONTROL         "Upload to Imgur",IDC_CHECK_UPLOAD_IMGUR,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,155,143,10
    LTEXT           "Client ID",IDC_STATIC,15,173,42,8
    EDITTEXT        IDC_EDIT_IMGUR_CLIENT_ID,61,170,199,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Test",IDC_BUTTON_TEST_IMGUR,265,170,47,14
    LTEXT           "Cache pin query",IDC_STATIC,15,191,55,8
    EDITTEXT        IDC_EDIT_LOCAL_ART_PIN_QUERY,74,188,186,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Imgur API...",IDC_BUTTON_IMGUR_HELP,265,188,47,14
    LTEXT           "Maximum size",IDC_STATIC,15,209,55,8
    EDITTEXT        IDC_EDIT_LOCAL_ART_MAX_WIDTH,74,206,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "x",IDC_STATIC,119,209,8,8
    EDITTEXT        IDC_EDIT_LOCAL_ART_MAX_HEIGHT,129,206,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "pixels (WebP)",IDC_STATIC,174,209,70,8
    LTEXT           "Order: Catbox, Imgur, MusicBrainz / Cover Art Archive, then TheAudioDB.",IDC_STATIC,15,227,293,9
    LTEXT           "Discord needs an Application ID, not an API key.",IDC_STATIC,9,255,205,9
    PUSHBUTTON      "Provider requirements...",IDC_BUTTON_PROVIDER_REQUIREMENTS,214,251,106,14
END

IDD_PREFS_TROUBLESHOOTING_TAB DIALOGEX 0, 0, 327, 268
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "Tahoma", 400, 0, 0x0
BEGIN
    GROUPBOX        "Why Discord may show another application",IDC_STATIC,6,8,314,82
    LTEXT           "Discord treats this Rich Presence and automatically recognised games or applications as separate activities.",IDC_STATIC,15,23,296,20
    LTEXT           "When both are active, Discord may display the recognised application instead of foobar2000. This component cannot inspect, reorder, or suppress other activities.",IDC_STATIC,15,49,296,32
    GROUPBOX        "Prefer foobar2000",IDC_STATIC,6,96,314,104
    LTEXT           "1. Open Discord > User Settings > Registered Games.",IDC_STATIC,15,112,296,10
    LTEXT           "2. Find the conflicting application and turn its eye icon off.",IDC_STATIC,15,128,296,10
    LTEXT           "3. Under Activity Sharing, keep `Share my activity` enabled.",IDC_STATIC,15,144,296,18
    PUSHBUTTON      "Open troubleshooting guide...",IDC_BUTTON_DISCORD_ACTIVITY_HELP,15,175,120,14
    GROUPBOX        "What artwork controls",IDC_STATIC,6,206,314,55
    LTEXT           "Album artwork changes only the large image on the foobar2000 activity card. It cannot replace another application's icon or change which activity Discord displays.",IDC_STATIC,15,221,296,30
END


